{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WowUpNight",
  "version": "2.25.4",
  "identifier": "io.wowupcf.tauri",
  "build": {
    "frontendDist": "../renderer-svelte/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run tauri:renderer:dev",
    "beforeBuildCommand": "npm run tauri:renderer:build"
  },
  "app": {
    "windows": [
      {
        "title": "WowUpNight",
        "width": 1280,
        "height": 720,
        "minWidth": 940,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#444444"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "WowUp LLC",
    "category": "Game",
    "shortDescription": "World of Warcraft addon updater",
    "longDescription": "World of Warcraft addon updater",
    "resources": {
      "../assets/WowUpAddon/*": "assets/WowUpAddon/",
      "../assets/wowup_logo_purple.png": "assets/wowup_logo_purple.png",
      "../assets/wowup_logo_cf.png": "assets/wowup_logo_cf.png"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxRDZGQzE1RkExODM0RkMKUldUOE5CajZGZnpXSVNmWXlCcFBGYnR4L3BxMjN4YnY1Wm9kT2JJYzBiSW1ZNi9SUkFWVW9FM2sK",
      "endpoints": [
        "https://github.com/alijohnzy/WowUp/releases/download/tauri-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
